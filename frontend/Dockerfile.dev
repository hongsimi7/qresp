# Node 14 (matches the verified local toolchain: Node 14.21.3 + Yarn classic).
# pm2 is pinned to a Node-14-compatible release (unpinned pulls pidusage@4 which
# requires Node >=18). Frontend app dependencies are unchanged.
FROM node:14.21.3-alpine

WORKDIR /usr/src/app

RUN yarn global add pm2@5.4.3

# Installing dependencies
COPY package*.json ./
COPY yarn.lock ./
RUN yarn install

# Copying source files
COPY . .